<div class="room-new-main container my-5">

<div class="card">
<h2 class="mt-4">施設新規登録</h2>
<div class="card-body">

<%= form_with model: @room, multipart: true do |f| %>

  <div class="field my-4">
    <label for="room_name" class="form-esse" %>施設名</label>
    <%= f.text_field :name, placeholder: "施設名を入力", autofocus: true, class: "form-control" %>
    <% @room.errors.where(:name).each do |error| %>
      <p class="error-text"><%= error.full_message %></p>
    <% end %>
  </div>

  <div class="field my-4">
    <label for="room_introduction" class="form-esse" %>施設詳細</label>
    <%= f.text_area :introduction, placeholder: "施設詳細を入力", class: "form-control" %>
    <% @room.errors.where(:introduction).each do |error| %>
      <p class="error-text"><%= error.full_message %></p>
    <% end %>
  </div>

  <div class="field my-4">
    <label for="room_charge" class="form-esse" %>料金</label>
    <%= f.number_field :charge, placeholder: "一日あたりの料金を入力", class: "form-control" %>
    <% @room.errors.where(:charge).each do |error| %>
      <p class="error-text"><%= error.full_message %></p>
    <% end %>
  </div>

  <div class="field border-bottom pb-5">
    <label for="room_address" class="form-esse" %>住所</label>
    <%= f.text_field :address, placeholder: "住所を入力", class: "form-control" %>
    <% @room.errors.where(:address).each do |error| %>
      <p class="error-text"><%= error.full_message %></p>
    <% end %>
  </div>

  <div class="field border-bottom pb-4 mt-4">
    <label class="room-image-new-area">
      <span class="room-image-new-label">施設画像</span>
      <span class="room-image-new-file">画像をアップロード</span>
      <%= f.file_field :image, class: "hidden" %>
    </label>
  </div>

  <%= f.hidden_field :current_user_id, value: current_user.id %>
  <%= f.hidden_field :room_id, value: @room.id %>

  <div class="actions mt-5 mb-4">
    <%= f.submit "保存する", class:"form-control btn-info mb-3" %>
    <%= link_to "戻る", rooms_own_path, class: "form-control btn-outline-info text-center" %>
  </div>

<% end %>

</div>
</div>

  <% if flash[:alert] %>
    <p class="alert"><%= flash[:alert] %></p>
  <% end %>

</div>