<div class="user-show-main container my-4">
  <h4 class="y-4 p-3">ユーザー情報</h4>

  <div class="show-contents border-bottom">
    <div class="user-show-btn mb-4"><%= link_to "アカウント", users_account_path, class: "btn btn-info btn-lg user-show-link" %></div>
    <div class="user-show-btn mb-4"><%= link_to "プロフィール", users_profile_path, class: "btn btn-outline-info btn-lg user-show-link" %></div>
  </div>

  <div class="user-show-header border-bottom my-4 p-3">
    <h2 class="user-show-account-title">アカウント</h2>
    <%= link_to "編集する", edit_user_registration_path, class: "user-show-account-edit" %>
  </div>
  <table class="user-show-contents mb-4 ml-5">
    <tr>
      <td align="right" class="text-nowrap">メールアドレス：</td>
      <td align="left"><%= current_user.email %></td>
    </tr>
    <tr>
      <td align="right" class="text-nowrap">パスワード：</td>
      <td align="left">*********</td>
    </tr>
  </table>

  <% if flash[:notice] %>
    <p class="notice"><%= flash[:notice] %></p>
  <% end %>

</div>