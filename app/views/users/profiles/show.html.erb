<div class="user-show-main container my-4">

  <h4 class="y-4 p-3">ユーザー情報</h4>

  <div class="show-contents border-bottom">
    <div class="user-show-btn mb-4"><%= link_to "アカウント", users_account_path, class: "btn btn-outline-info btn-lg user-show-link" %></div>
    <div class="user-show-btn mb-4"><%= link_to "プロフィール", users_profile_path, class: "btn btn-info btn-lg user-show-link" %></div>
  </div>

  <div class="user-show-header border-bottom mt-4 p-3">
    <h2 class="user-show-profile-title">プロフィール</h2>
    <%= link_to "編集する", edit_users_profile_path, class: "user-show-profile-edit" %>
  </div>
  <table class="user-show-contents mb-4 mx-5">
    <tr height="150">
      <td align="right" class="text-nowrap">アイコン画像：</td>
      <td align="left" class="user-show-profile-avatar" >
        <% if current_user.avatar.blank? %>
          <%= image_tag "default-avatar-7a6cbfd7993e89f24bfc888f4a035a83c6f1428b8bdc47eed9095f2799a40153.png", size: "80x80", alt: "アイコン画像", class: "profile-icon" %>
        <% else %>
          <%= image_tag(current_user.avatar.variant(gravity: :center, resize:"80x80^", crop:"80x80+0+0"), alt: "アイコン画像", class: "profile-icon") %>
        <% end %>
      </td>
    </tr>
    <tr>
      <td align="right" valign="top" class="text-nowrap">ユーザーネーム：</td>
      <td align="left" valign="top"><%= current_user.user_name %></td>
    </tr>
    <tr>
      <td align="right" valign="top" class="text-nowrap">自己紹介：</td>
      <td align="left" valign="top"><%= current_user.profile %></td>
    </tr>
  </table>

  <% if flash[:notice] %>
    <p class="notice"><%= flash[:notice] %></p>
  <% end %>

</div>